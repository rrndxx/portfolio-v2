# Local SQLite (used by `npm run db:seed` and by the app when Turso is unset)
DATABASE_URL=file:./data/portfolio.db

# Turso (production on Netlify + `npm run db:seed:turso`)
# Create a *database* token in Turso dashboard (not only an org/platform token).
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Optional force: local | turso | auto (app runtime; seed scripts set this themselves)
# DB_TARGET=auto

# Admin console at /admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=long-random-string

# Existing resume API (unchanged)
# RESUME_API_KEY=
# RESUME_CORS_ORIGINS=
