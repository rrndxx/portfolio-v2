# Local SQLite (default if unset: file:./data/portfolio.db)
DATABASE_URL=file:./data/portfolio.db

# Turso (production on Netlify) — when set, this overrides DATABASE_URL
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Admin console at /admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=long-random-string

# Existing resume API (unchanged)
# RESUME_API_KEY=
# RESUME_CORS_ORIGINS=
